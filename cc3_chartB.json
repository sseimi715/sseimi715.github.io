{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "cc3_aging.csv"},
  "title": {"text": "Old-age dependency ratio, South Korea"},
  "width": 350,
  "height": 280,
  "mark": {"type": "line", "color": "navy"},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {"domain": [1950, 2023]},
      "axis": {"format": "d", "tickCount": 15, "title": ""}
    },
    "y": {
      "field": "Ratio",
      "type": "quantitative",
      "axis": {"title": ""}
    }
  }
}
